# Required runtime settings. Never commit the real .env file.
NODE_ENV=development
PORT=10000
DATA_DIR=./storage
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
APP_URL=http://localhost:10000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-14-character-or-longer-password
APP_ENCRYPTION_KEY=replace-with-a-random-secret-at-least-32-characters-long

# Optional fallback API settings for users without custom credentials. Prefer assigning credentials per account in /admin.
AI_BASE_URL=https://your-provider.example/v1
AI_MODEL_ID=your-model-id
AI_API_KEY=replace-with-provider-key

SUBSCRIPTION_DISPLAY_PRICE=تفعيل يدوي بعد مراجعة الإدارة

# Subscription approval is manual through /admin. Stripe is not required.
