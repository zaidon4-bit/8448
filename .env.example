# Required runtime settings. Never commit a real .env file.
NODE_ENV=development
PORT=10000
DATA_DIR=./storage
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
APP_URL=http://localhost:10000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-14-character-or-longer-password
APP_ENCRYPTION_KEY=replace-with-a-random-stable-secret-at-least-32-characters-long

# Optional shared fallback AI connection. You can instead configure each user in /admin.
AI_BASE_URL=https://api.odirouter.ai/v1
AI_MODEL_ID=replace-with-a-model-id-listed-by-your-provider
AI_API_KEY=replace-with-your-provider-key

SUBSCRIPTION_DISPLAY_PRICE=Manual activation after administrator review
MAX_ACTIVE_OPENCODE_INSTANCES=2
AI_REQUESTS_PER_MINUTE=15
